{
  "expo": {
    "name": "Yorde What Store - Vendedor",
    "slug": "yws-staff",
    "scheme": "ywsstaff",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yordewhatstore.staff"
    },
    "android": {
      "package": "com.yordewhatstore.staff",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4f46e5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para agregar imágenes a tus productos.",
          "cameraPermission": "Necesitamos la cámara para que puedas fotografiar tus productos.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7a52dd7f-2479-4452-b3d6-b53fe2488693"
      }
    },
    "owner": "yorde91"
  }
}
