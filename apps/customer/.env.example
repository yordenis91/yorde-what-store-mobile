# Copy to .env.local (git-ignored) and point it at your machine's LAN IP so a
# phone on the same Wi-Fi can reach the api, e.g. http://192.168.1.50:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# The web storefront's root domain (its storefrontRootDomain), so pasted
# <slug>.<root> share links are read like the web does. Optional.
EXPO_PUBLIC_STOREFRONT_ROOT_DOMAIN=yws.yordeniscorreoso.com
