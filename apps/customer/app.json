{
  "expo": {
    "name": "Yorde What Store",
    "slug": "yws-customer",
    "scheme": "ywstore",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yordewhatstore.customer"
    },
    "android": {
      "package": "com.yordewhatstore.customer",
      "adaptiveIcon": {
        "backgroundColor": "#3b82f6"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "ywstore",
              "host": "store"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#3b82f6"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1c885a43-d041-41ab-95a6-3ae670792d18"
      }
    },
    "owner": "yorde91"
  }
}
